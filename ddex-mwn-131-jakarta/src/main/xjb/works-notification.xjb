<?xml version="1.0" encoding="UTF-8"?>
<jaxb:bindings version="3.0" xmlns:jaxb="https://jakarta.ee/xml/ns/jaxb"
    xmlns:xs="http://www.w3.org/2001/XMLSchema">
    <jaxb:bindings>
        <jaxb:globalBindings typesafeEnumMaxMembers="100000" />
    </jaxb:bindings>

    <jaxb:bindings schemaLocation="../resources/xsd/mwn1.3.1/works-share-notification-choreography.xsd ">
        <jaxb:bindings node="//xs:complexType[@name='Entry']">
            <jaxb:class name="EntryComplexType" />
        </jaxb:bindings>

        <jaxb:bindings
            node="//xs:element[@name='Entry']/xs:complexType/xs:choice/xs:element[@name='title']">
            <jaxb:class name="titleText" />
        </jaxb:bindings>

        <jaxb:bindings
            node="//xs:complexType[@name='Entry']/xs:choice/xs:element[@name='title']">
            <jaxb:class name="titleText" />
        </jaxb:bindings>
        <!-- RightShare and SocietyAffiliation both have ExcludedTerritoryCode appearing twice
             inside the same xs:choice (once standalone, once inside a nested xs:sequence).
             Jakarta JAXB 4.0.8 treats this as a hard error. We provide hand-written classes
             and instruct XJC to use them instead of attempting code generation for these types. -->
        <jaxb:bindings node="//xs:complexType[@name='RightShare']">
            <jaxb:class ref="net.ddex.xml.mc_notif._131.RightShare" />
        </jaxb:bindings>

        <jaxb:bindings node="//xs:complexType[@name='SocietyAffiliation']">
            <jaxb:class ref="net.ddex.xml.mc_notif._131.SocietyAffiliation" />
        </jaxb:bindings>

    </jaxb:bindings>

</jaxb:bindings>